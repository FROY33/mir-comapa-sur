# API de COMAPA MIR. Escucha solo en 127.0.0.1:3000; desde fuera se llega por el sitio.
# Instalar: sudo cp comapa-api.service /etc/systemd/system/ && sudo systemctl enable --now comapa-api
[Unit]
Description=COMAPA MIR — API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=comapa
Group=comapa
WorkingDirectory=/opt/comapa-mir/backend
EnvironmentFile=/etc/comapa-mir/api.env
ExecStart=/usr/bin/node dist/servidor.js
Restart=on-failure
RestartSec=5
# El backend registra el apagado en la bitácora al recibir SIGTERM
KillSignal=SIGTERM
TimeoutStopSec=20

# Endurecimiento: sin privilegios, sistema de archivos de solo lectura salvo lo indispensable
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
RestrictNamespaces=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
