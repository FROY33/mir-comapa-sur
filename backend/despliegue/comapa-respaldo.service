# Respaldo diario de la base (lo dispara comapa-respaldo.timer). Conserva 14 días.
[Unit]
Description=COMAPA MIR — respaldo de la base
After=postgresql.service

[Service]
Type=oneshot
User=root
EnvironmentFile=/etc/comapa-mir/dueno.env
ExecStart=/opt/comapa-mir/backend/despliegue/respaldar.sh
UMask=0077
