# /etc/comapa-mir/api.env — dueño root:comapa, permisos 640. No se versiona con valores reales.
NODE_ENV=production
PORT=3000
HOST=127.0.0.1
# Rol de permisos mínimos (db/permisos.sql), NUNCA el dueño de las tablas
DATABASE_URL=postgres://comapa_app:CAMBIAR@127.0.0.1:5432/comapa_mir
# Detrás de Cloudflare Tunnel: la IP real llega en CF-Connecting-IP
CONFIAR_PROXY=true
CICLOS_AUTOMATICOS=true
