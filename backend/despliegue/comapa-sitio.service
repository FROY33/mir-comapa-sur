# Sitio de COMAPA MIR: páginas + proxy a la API. Escucha solo en 127.0.0.1:4321; cloudflared apunta aquí.
# Instalar: sudo cp comapa-sitio.service /etc/systemd/system/ && sudo systemctl enable --now comapa-sitio
[Unit]
Description=COMAPA MIR — Sitio
After=network-online.target comapa-api.service
Wants=network-online.target

[Service]
Type=simple
User=comapa
Group=comapa
WorkingDirectory=/opt/comapa-mir/backend
EnvironmentFile=/etc/comapa-mir/sitio.env
ExecStart=/usr/bin/node dist/sitio.js
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=20

# Endurecimiento: sin privilegios, sistema de archivos de solo lectura salvo lo indispensable
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
RestrictNamespaces=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
