# API de COMAPA MIR en icarus. Escucha solo en 127.0.0.1:3087; desde fuera se llega por el sitio.
# Instalar (icarus): sudo -n systemctl link /home/developer/comapa-mir/backend/despliegue/icarus/comapa-api.service && sudo -n systemctl enable --now comapa-api
[Unit]
Description=COMAPA MIR — API
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=developer
WorkingDirectory=/home/developer/comapa-mir/backend
EnvironmentFile=/home/developer/comapa-mir-config/api.env
ExecStart=/usr/local/lib/nodejs/node-v22.21.1-linux-x64/bin/node dist/servidor.js
Restart=on-failure
RestartSec=5
# El backend registra el apagado en la bitácora al recibir SIGTERM
KillSignal=SIGTERM
TimeoutStopSec=20

# Endurecimiento: sin privilegios, sistema de archivos de solo lectura salvo lo indispensable
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
RestrictNamespaces=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
