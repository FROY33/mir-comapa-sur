# Copia este archivo como .env (no se versiona) y ajusta los valores.
# En producción no hay .env: las variables las pone la plataforma.

# Conexión a PostgreSQL. Formato: postgres://usuario:clave@host:5432/base
# En macOS con Homebrew y tu usuario local basta con:
DATABASE_URL=postgres://localhost/comapa_mir

PORT=3000
# Interfaz donde escucha la API (127.0.0.1 por defecto: solo el sitio llega a ella)
# HOST=127.0.0.1

# Opcionales (valores por defecto)
# Solo si hay un proxy o balanceador propio delante: la IP de la auditoría se toma
# entonces de X-Forwarded-For. Expuesto directo, déjalo en false.
# CONFIAR_PROXY=false
# Apertura automática de ciclos de reporte (HU-R3-01), al arrancar y cada hora
# CICLOS_AUTOMATICOS=true
# BD_MAX_CONEXIONES=10
# BD_TIMEOUT_CONEXION_MS=5000
# BD_TIMEOUT_CONSULTA_MS=15000

# Carga inicial (db/sembrar.sh). Sin valor por defecto: la carga no corre sin ella.
# SEMILLA_PASSWORD=
