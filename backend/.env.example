# Copia este archivo como .env (no se versiona) y ajusta los valores.
# En producción no hay .env: las variables las pone la plataforma.

# Conexión a PostgreSQL. Formato: postgres://usuario:clave@host:5432/base
# En macOS con Homebrew y tu usuario local basta con:
DATABASE_URL=postgres://localhost/comapa_mir

PORT=3000

# Opcionales (valores por defecto)
# BD_MAX_CONEXIONES=10
# BD_TIMEOUT_CONEXION_MS=5000
# BD_TIMEOUT_CONSULTA_MS=15000
