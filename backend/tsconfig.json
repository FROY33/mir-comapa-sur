{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": ["node"],
    "noEmit": true,
    // extraer.ts y cargar.ts importan con .js y corren con tsx, igual que src/
    "allowImportingTsExtensions": true
  },
  "include": ["src", "pruebas", "db", "dev"]
}
